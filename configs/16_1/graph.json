{
    "node.description": "MacBook Pro T2 DSP Speakers",
    "media.name": "MacBook Pro T2 DSP Speakers",
    "filter.graph": {
        "nodes": [
            {
                "type": "lv2",
                "plugin": "https://chadmed.au/bankstown",
                "name": "virtualbass",
                "control": {
                    "bypass": 0,
                    "amt": 3.0,
                    "sat_second": 1.5,
                    "sat_third": 1.5,
                    "blend": 0.75,
                    "ceil": 150.0,
                    "floor": 40.0
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/loud_comp_mono",
                "name": "ell",
                "control": {
                    "enabled": 1,
                    "input": 1.0,
                    "fft": 4
                }
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "copyL"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "copyR"
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/loud_comp_mono",
                "name": "elr",
                "control": {
                    "enabled": 1,
                    "input": 1.0,
                    "fft": 4
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convLT",
                "config": {
                    "filename": [
                        "/usr/share/t2linux-audio/16_1/tweeters-44k.wav",
                        "/usr/share/t2linux-audio/16_1/tweeters-48k.wav",
                        "/usr/share/t2linux-audio/16_1/tweeters-96k.wav"
                    ],
                    "channel": 0,
                    "gain": 1.0
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convRT",
                "config": {
                    "filename": [
                        "/usr/share/t2linux-audio/16_1/tweeters-44k.wav",
                        "/usr/share/t2linux-audio/16_1/tweeters-48k.wav",
                        "/usr/share/t2linux-audio/16_1/tweeters-96k.wav"
                    ],
                    "channel": 0,
                    "gain": 1.0
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convLW",
                "config": {
                    "filename": [
                        "/usr/share/t2linux-audio/16_1/woofers-44k.wav",
                        "/usr/share/t2linux-audio/16_1/woofers-48k.wav",
                        "/usr/share/t2linux-audio/16_1/woofers-96k.wav"
                    ],
                    "channel": 0,
                    "gain": 1.0
                }
            },
            {
                "type": "builtin",
                "label": "convolver",
                "name": "convRW",
                "config": {
                    "filename": [
                        "/usr/share/t2linux-audio/16_1/woofers-44k.wav",
                        "/usr/share/t2linux-audio/16_1/woofers-48k.wav",
                        "/usr/share/t2linux-audio/16_1/woofers-96k.wav"
                    ],
                    "channel": 0,
                    "gain": 1.0
                }
            },
            {
                "type": "lv2",
                "plugin": "http://lsp-plug.in/plugins/lv2/compressor_stereo",
                "name": "woofer_lim",
                "control": {
                    "sla": 5.0,
                    "al": 1.0,
                    "at": 1.0,
                    "rt": 100.0,
                    "cr": 15.0,
                    "kn": 0.5
                }
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "copyLW"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "copyRW"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "LW"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "LW2"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "RW"
            },
            {
                "type": "builtin",
                "label": "copy",
                "name": "RW2"
            }
        ],
        "links": [
            {"output": "virtualbass:out_l", "input": "ell:in"},
            {"output": "virtualbass:out_r", "input": "elr:in"},
            {"output": "ell:out", "input": "copyL:In"},
            {"output": "elr:out", "input": "copyR:In"},
            {"output": "copyL:Out", "input": "convLT:In"},
            {"output": "copyL:Out", "input": "convLW:In"},
            {"output": "copyR:Out", "input": "convRT:In"},
            {"output": "copyR:Out", "input": "convRW:In"},
            {"output": "convLW:Out", "input": "woofer_lim:in_l"},
            {"output": "convRW:Out", "input": "woofer_lim:in_r"},
            {"output": "woofer_lim:out_l", "input": "copyLW:In"},
            {"output": "woofer_lim:out_r", "input": "copyRW:In"},
            {"output": "copyLW:Out", "input": "LW:In"},
            {"output": "copyRW:Out", "input": "RW:In"},
            {"output": "copyLW:Out", "input": "LW2:In"},
            {"output": "copyRW:Out", "input": "RW2:In"}
        ],
        "inputs": [
            "virtualbass:in_l",
            "virtualbass:in_r"
        ],
        "outputs": [
            "LW:Out",
            "LW2:Out",
            "convLT:Out",
            "RW:Out",
            "RW2:Out",
            "convRT:Out"
        ],
        "capture.volumes": [
            {
                "control": "ell:volume",
                "min": -65.0,
                "max": 0.0,
                "scale": "cubic"
            },
            {
                "control": "elr:volume",
                "min": -65.0,
                "max": 0.0,
                "scale": "cubic"
            }
        ]
    },
    "capture.props": {
        "node.name": "audio_effect.t2-161-speakers",
        "media.class": "Audio/Sink",
        "audio.channels": "2",
        "audio.position": ["FL", "FR"],
        "device.api": "dsp",
        "audio.allowed-rates": [48000, 44100],
        "node.virtual": "false",
        "priority.session": 1500,
        "state.default-volume": 0.75,
        "device.icon-name": "audio-speakers"
    },
    "playback.props": {
        "node.name": "effect_output.t2-161-speakers",
        "node.description": "MacBook Pro T2 DSP Speakers Out",
        "media.name": "MacBook Pro T2 DSP Speakers Out",
        "target.object": "alsa_output.platform-sound.RawSpeakers",
        "node.dont-fallback": "true",
        "node.passive": "true",
        "audio.channels": "6",
        "audio.allowed-rates": [48000, 44100],
        "audio.position": ["AUX0", "AUX1", "AUX2", "AUX3", "AUX4", "AUX5"]
    }
}
